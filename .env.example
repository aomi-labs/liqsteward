PORT=4310
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
MORPHO_API_URL=https://api.morpho.org/graphql
WEB_ORIGIN=http://localhost:4311
# Aomi backend for deployed-app discovery.
AOMI_BACKEND_URL=https://api-staging.aomi.dev
# Matching Aomi portal for origin-bound guest auth and the public Agent API.
AOMI_PORTAL_URL=https://chat-staging.aomi.dev
# Comma-separated Aomi apps the console offers, first is the default.
AOMI_APPS=nav-oracle,liqsteward
# NAV oracle store and the bearer token Aomi apps present on /api/nav/*.
DATABASE_URL=postgresql://localhost:5432/liqsteward
# PEM root certificate for production PostgreSQL TLS verification; leave unset locally.
DATABASE_CA_CERT=
LIQSTEWARD_SERVICE_TOKEN=change-me
